# ===== 大模型配置 =====
# DashScope API Key（必填，从阿里云灵积平台获取）
DASHSCOPE_API_KEY=sk-cf0f1465b90a431dbb20c8fbdb0a74a1
# API 基础地址（DashScope 兼容 OpenAI 格式）
BASE_URL=https://api.deepseek.com
# Agent 主模型（推荐 qwen-plus，平衡性能与成本）
AGENT_BASE_MODEL=deepseek-v4-pro

# 记忆提取模型（后台任务使用，建议用小模型节省成本）
SUMMARIZATION_MODEL=deepseek-flash

# ===== 嵌入模型配置 =====
# 文本向量化模型（用于知识库和记忆的语义检索）
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_URL=https://api.siliconflow.cn/v1
# 向量维度（text-embedding-v4 为 1024 维）
dense_dimension=1024

# ===== Rerank 重排序配置 =====
# 重排序模型（用于优化检索结果的相关性排序）
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# 重排序 API 地址
RERANK_URL=https://api.siliconflow.cn/v1/rerank
# 重排序 API Key（默认与 DASHSCOPE_API_KEY 相同）
RERANK_API_KEY=sk-qmohkwpfepnfwzahqqnwsrqqukkwevypnynkaqrjhtqrmyxh
# SiliconFlow（硅基流动/轨迹流动）API Key，用于 embedding + rerank
SILICONFLOW_API_KEY=sk-qmohkwpfepnfwzahqqnwsrqqukkwevypnynkaqrjhtqrmyxh

# ===== Milvus 向量数据库配置 =====
# Zilliz Cloud 服务地址（或自建 Milvus 地址）
Milvus_url=https://in03-16be74a304eb85c.serverless.aws-eu-central-1.cloud.zilliz.com
# 认证 Token（Zilliz Cloud 格式：username:password）
Token=b72c27054a0b4a663d8bf2f9fd296b969e8593fa711afa1424525c15b9b95eeb9ee208cef06cfacd6c154dfec64e1a896ab8549c

# 知识库集合名称
knowledge_base_collection=sunsun

# 记忆集合名称
memory_collection=memory_collection

# ===== PostgreSQL 数据库配置 =====
# 完整连接字符串（包含用户名、密码、主机、端口、数据库名）
DATABASE_URL=postgresql://postgres:sunsun@localhost:5432/echomind_db?sslmode=disable

# 分项配置（用于程序自动创建数据库）
PG_USER=postgres
PG_PASSWORD=sunsun
PG_HOST=localhost
PG_PORT=5432
PG_DB_NAME=echomind_db

# ===== Redis 配置 =====
# Redis 连接地址（用于对话检查点存储和用户画像缓存）
REDIS_URL=redis://localhost:6379/0

# ===== 临时文件目录 =====
# 文档上传后的临时存储路径
TEMP_DIR=/tmp
PORT=8000